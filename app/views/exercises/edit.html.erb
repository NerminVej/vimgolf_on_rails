<div class="w-full max-w-4xl mx-auto px-6 py-8" style="padding-top: 80px;">
  <div class="text-center mb-8 slide-in">
    <div style="font-size: 64px; margin-bottom: 16px; filter: drop-shadow(0 0 20px var(--neon-blue));">✏️</div>
    <h1 class="text-5xl font-bold mb-2 text-gradient" style="font-family: 'JetBrains Mono', monospace;">
      Edit Challenge
    </h1>
    <p style="color: var(--text-muted); font-size: 16px;">Modify your Vim challenge settings</p>
  </div>

  <div class="game-card slide-in" style="animation-delay: 0.1s; padding: 40px;">
    <%= render "form", exercise: @exercise %>
  </div>
</div>

<%= simple_form_for exercise, html: { class: "space-y-6" } do |f| %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <% if f.object.errors.any? %>
    <div class="flash-message error" style="margin-bottom: 24px;">
      <h2 class="font-semibold mb-2" style="color: var(--neon-red); font-size: 16px;">
        ⚠️ <%= pluralize(f.object.errors.count, "error") %> prevented this challenge from being saved:
      </h2>
      <ul style="list-style: disc; padding-left: 24px; color: var(--text-secondary);">
        <% f.object.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.input :title,
              label: "Challenge Title",
              placeholder: "e.g., Swap Variable Assignments",
              required: true,
              input_html: {
                class: "form-input #{'border-red-500' if f.object.errors[:title].any?}"
              },
              label_html: { class: "form-label" },
              wrapper_html: { class: "mb-6" },
              hint: "3-200 characters",
              hint_html: { style: "color: var(--text-muted); font-size: 12px; margin-top: 4px;" },
              error_html: { style: "color: var(--neon-red); font-size: 13px; margin-top: 4px; font-weight: 600;" } %>

  <%= f.input :description,
              as: :text,
              label: "Mission Briefing",
              placeholder: "Describe the challenge and what needs to be accomplished...",
              required: true,
              input_html: {
                rows: 4,
                class: "form-input #{'border-red-500' if f.object.errors[:description].any?}"
              },
              label_html: { class: "form-label" },
              wrapper_html: { class: "mb-6" },
              hint: "10-2000 characters",
              hint_html: { style: "color: var(--text-muted); font-size: 12px; margin-top: 4px;" },
              error_html: { style: "color: var(--neon-red); font-size: 13px; margin-top: 4px; font-weight: 600;" } %>

  <%= f.input :start_file,
              as: :text,
              label: "Start File (Initial State)",
              placeholder: "Enter the starting content...",
              required: true,
              input_html: {
                rows: 10,
                class: "form-input #{'border-red-500' if f.object.errors[:start_file].any?}",
                style: "font-family: 'JetBrains Mono', monospace; font-size: 14px; line-height: 1.6;"
              },
              label_html: { class: "form-label" },
              wrapper_html: { class: "mb-6" },
              hint: "The initial state of the file that users will start with.",
              hint_html: { style: "color: var(--text-muted); font-size: 12px; margin-top: 4px;" },
              error_html: { style: "color: var(--neon-red); font-size: 13px; margin-top: 4px; font-weight: 600;" } %>

  <%= f.input :end_file,
              as: :text,
              label: "End File (Target State) 🎯",
              placeholder: "Enter the target content...",
              required: true,
              input_html: {
                rows: 10,
                class: "form-input #{'border-red-500' if f.object.errors[:end_file].any?}",
                style: "font-family: 'JetBrains Mono', monospace; font-size: 14px; line-height: 1.6; border-color: var(--neon-green);"
              },
              label_html: { class: "form-label", style: "color: var(--neon-green);" },
              wrapper_html: { class: "mb-6" },
              hint: "The desired final state after Vim transformations.",
              hint_html: { style: "color: var(--text-muted); font-size: 12px; margin-top: 4px;" },
              error_html: { style: "color: var(--neon-red); font-size: 13px; margin-top: 4px; font-weight: 600;" } %>

  <div class="flex gap-4">
    <%= f.submit class: "btn-primary", style: "cursor: pointer; padding: 14px 28px; font-size: 16px;" %>
    <%= link_to "Cancel", exercises_path, class: "btn-secondary", style: "padding: 14px 28px; font-size: 16px; text-decoration: none; display: inline-block;" %>
  </div>
<% end %>

<%= form_with(model: exercise, class: "space-y-6") do |form| %>
  <% if exercise.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h2 class="text-lg font-semibold text-red-800 mb-2">
        <%= pluralize(exercise.errors.count, "error") %> prohibited this exercise from being saved:
      </h2>
      <ul class="list-disc list-inside text-red-700">
        <% exercise.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.text_field :title, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500", placeholder: "e.g., Swap Variable Assignments" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.text_area :description, rows: 4, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500", placeholder: "Describe the challenge and what needs to be accomplished..." %>
  </div>

  <div>
    <%= form.label :start_file, "Start File (Initial State)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.text_area :start_file, rows: 10, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono text-sm", placeholder: "Enter the starting content..." %>
    <p class="text-sm text-gray-500 mt-1">The initial state of the file that users will start with.</p>
  </div>

  <div>
    <%= form.label :end_file, "End File (Goal State)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.text_area :end_file, rows: 10, class: "w-full px-4 py-2 border border-green-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 font-mono text-sm", placeholder: "Enter the target content..." %>
    <p class="text-sm text-gray-500 mt-1">The desired final state after Vim transformations.</p>
  </div>

  <div class="flex gap-3">
    <%= form.submit class: "px-6 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition font-semibold cursor-pointer" %>
    <%= link_to "Cancel", exercises_path, class: "px-6 py-3 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition font-semibold" %>
  </div>
<% end %>

<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-4xl font-bold text-gray-800">VimGolf Exercises</h1>
      <% if @pagy.count > 0 %>
        <p class="text-sm text-gray-600 mt-1">Showing <%= @pagy.from %>-<%= @pagy.to %> of <%= @pagy.count %> exercises</p>
      <% end %>
    </div>
    <%= link_to "Create New Exercise", new_exercise_path, class: "px-6 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition font-semibold" %>
  </div>

  <% if @exercises.any? %>
    <!-- Desktop Table View -->
    <div class="bg-white shadow-md rounded-lg overflow-hidden hidden md:block">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Title</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Description</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Creator</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Created</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-700 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @exercises.each do |exercise| %>
            <tr class="hover:bg-gray-50 transition">
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to exercise.title, exercise_path(exercise), class: "text-blue-600 hover:text-blue-800 font-semibold" %>
              </td>
              <td class="px-6 py-4">
                <p class="text-sm text-gray-600 line-clamp-2"><%= truncate(exercise.description, length: 100) %></p>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                <%= exercise.user.email.split('@').first %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= time_ago_in_words(exercise.created_at) %> ago
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex justify-end gap-2">
                  <%= link_to "View", exercise_path(exercise), class: "text-blue-600 hover:text-blue-800" %>
                  <% if exercise.user == current_user %>
                    <%= link_to "Edit", edit_exercise_path(exercise), class: "text-yellow-600 hover:text-yellow-800" %>
                    <%= button_to "Delete", exercise_path(exercise), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-800" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Mobile Card View -->
    <div class="space-y-3 md:hidden">
      <% @exercises.each do |exercise| %>
        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
          <h3 class="font-semibold text-gray-800 mb-2">
            <%= link_to exercise.title, exercise_path(exercise), class: "text-blue-600 hover:text-blue-800" %>
          </h3>
          <p class="text-sm text-gray-600 mb-2"><%= truncate(exercise.description, length: 80) %></p>
          <div class="flex justify-between items-center text-xs text-gray-500">
            <span><%= exercise.user.email.split('@').first %> • <%= time_ago_in_words(exercise.created_at) %> ago</span>
            <% if exercise.user == current_user %>
              <div class="flex gap-2">
                <%= link_to "Edit", edit_exercise_path(exercise), class: "text-yellow-600" %>
                <%= button_to "Delete", exercise_path(exercise), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-red-600" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="mt-6">
      <%= render "shared/pagy_nav", pagy: @pagy %>
    </div>
  <% else %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-8 text-center">
      <p class="text-gray-700 text-lg mb-4">No exercises yet. Be the first to create one!</p>
      <%= link_to "Create First Exercise", new_exercise_path, class: "px-6 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition font-semibold inline-block" %>
    </div>
  <% end %>
</div>

<%# Gaming-themed Pagy navigation %>
<% if pagy.pages > 1 %>
  <nav class="flex items-center justify-center gap-2" aria-label="Pagination">
    <%# Previous page link %>
    <% if pagy.prev %>
      <%= link_to pagy.url_for(pagy.prev), class: "btn-secondary", style: "padding: 10px 14px; font-size: 14px;", aria_label: "Previous page" do %>
        <svg style="width: 18px; height: 18px;" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
      <% end %>
    <% else %>
      <span style="padding: 10px 14px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 8px; color: var(--text-muted); cursor: not-allowed; display: inline-flex; align-items: center;">
        <svg style="width: 18px; height: 18px;" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
      </span>
    <% end %>

    <%# Page number links %>
    <% pagy.series.each do |item| %>
      <% if item.is_a?(Integer) %>
        <% if item == pagy.page %>
          <span style="padding: 10px 16px; background: linear-gradient(135deg, var(--neon-blue) 0%, var(--neon-purple) 100%); border: 2px solid var(--neon-blue); border-radius: 8px; color: white; font-weight: 700; font-family: 'JetBrains Mono', monospace; box-shadow: 0 0 15px rgba(0, 217, 255, 0.5); min-width: 44px; text-align: center; display: inline-block;">
            <%= item %>
          </span>
        <% else %>
          <%= link_to item, pagy.url_for(item), class: "btn-secondary", style: "padding: 10px 16px; font-size: 14px; font-family: 'JetBrains Mono', monospace; min-width: 44px; text-align: center; display: inline-block; text-decoration: none;" %>
        <% end %>
      <% elsif item == :gap %>
        <span style="padding: 10px 12px; color: var(--text-muted); font-weight: 600;">...</span>
      <% end %>
    <% end %>

    <%# Next page link %>
    <% if pagy.next %>
      <%= link_to pagy.url_for(pagy.next), class: "btn-secondary", style: "padding: 10px 14px; font-size: 14px;", aria_label: "Next page" do %>
        <svg style="width: 18px; height: 18px;" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
        </svg>
      <% end %>
    <% else %>
      <span style="padding: 10px 14px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 8px; color: var(--text-muted); cursor: not-allowed; display: inline-flex; align-items: center;">
        <svg style="width: 18px; height: 18px;" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
        </svg>
      </span>
    <% end %>
  </nav>
<% end %>

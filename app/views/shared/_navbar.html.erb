<style>
  nav .btn-primary:hover,
  nav .btn-secondary:hover,
  nav .btn-danger:hover,
  nav .btn-success:hover {
    transform: none !important;
    box-shadow: none !important;
    background: unset !important;
    border-color: unset !important;
  }
  nav .btn-primary:hover { background: linear-gradient(135deg, var(--neon-blue) 0%, var(--neon-purple) 100%) !important; }
  nav .btn-primary:hover::before { left: -100% !important; }
  nav .btn-secondary:hover { background: rgba(255, 255, 255, 0.1) !important; border-color: rgba(255, 255, 255, 0.2) !important; }
  nav .btn-danger:hover { background: linear-gradient(135deg, var(--neon-red) 0%, #dc2626 100%) !important; }
  nav .btn-success:hover { background: linear-gradient(135deg, var(--neon-green) 0%, #059669 100%) !important; }
</style>
<div class="px-6 pt-6" style="position: relative; z-index: 10;">
  <nav style="background: rgba(10, 14, 39, 0.75); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-radius: 16px; border: 1px solid rgba(0, 217, 255, 0.2); box-shadow: 0 4px 32px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255,255,255,0.04) inset;">
    <div class="px-12 py-4 flex justify-between items-center">
      <!-- Brand -->
      <div class="flex items-center gap-8">
        <%= link_to root_path, class: "flex items-center gap-3 group" do %>
          <div class="text-2xl font-bold" style="font-family: 'JetBrains Mono', monospace;">
            <span style="color: var(--neon-blue);">V</span><span style="color: var(--neon-purple);">I</span><span style="color: var(--neon-pink);">M</span><span style="color: var(--text-primary);">GOLF</span>
          </div>
        <% end %>

        <% if user_signed_in? %>
          <div class="flex items-center gap-2">
            <%= link_to exercises_path, class: "text-gray-400 font-medium px-3 py-1.5" do %>
              Exercises
            <% end %>
            <%= button_to practice_sessions_path, method: :post, class: "btn-primary" do %>
              <span style="margin-right: 6px;">⚡</span>Practice
            <% end %>
            <%= button_to star_hunt_sessions_path, method: :post, class: "btn-primary" do %>
              <span style="margin-right: 6px;">⭐</span>Star Hunt
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Right side -->
      <div class="flex items-center gap-3">
        <% if user_signed_in? %>
          <span class="text-sm font-mono px-3 py-1.5 rounded-lg" style="color: var(--neon-blue); background: rgba(0, 217, 255, 0.08); border: 1px solid rgba(0, 217, 255, 0.2);">
            <%= current_user.email.split('@').first %>
          </span>
          <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "btn-danger" %>
        <% else %>
          <%= link_to "Sign In", new_user_session_path, class: "btn-secondary" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "btn-success" %>
        <% end %>
      </div>
    </div>
  </nav>
</div>

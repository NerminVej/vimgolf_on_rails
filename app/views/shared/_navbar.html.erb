<nav class="glass-card" style="background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-radius: 0; border-top: none; border-left: none; border-right: none; border-bottom: 2px solid var(--border-primary);">
  <div class="mx-auto px-24 py-6 flex justify-between items-center w-full">
    <!-- Brand -->
    <div class="flex items-center gap-8">
      <%= link_to root_path, class: "flex items-center gap-3 group" do %>
        <div class="text-2xl font-bold text-gradient" style="font-family: 'JetBrains Mono', monospace;">
          <span style="color: var(--neon-blue);">V</span><span style="color: var(--neon-purple);">I</span><span style="color: var(--neon-pink);">M</span>GOLF
        </div>
      <% end %>

      <% if user_signed_in? %>
        <div class="flex items-center gap-6">
          <%= link_to exercises_path, class: "text-gray-300 hover:text-white font-semibold transition-all hover:text-shadow relative group px-4" do %>
            <span>Exercises</span>
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-blue-500 to-purple-500 group-hover:w-full transition-all duration-300"></span>
          <% end %>
          <%= button_to practice_sessions_path, method: :post, class: "btn-primary" do %>
            <span style="margin-right: 8px;">⚡</span>Practice Mode
          <% end %>
          <%= button_to star_hunt_sessions_path, method: :post, class: "btn-primary" do %>
            <span style="margin-right: 8px;">⭐</span>Star Hunt
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Navigation Links -->
    <div class="flex items-center gap-6">
      <% if user_signed_in? %>
        <!-- Authenticated User -->
        <div class="flex items-center gap-4 px-6 py-3 rounded-lg" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);">
          <span class="text-sm" style="color: var(--text-muted);">Player:</span>
          <span class="font-semibold" style="color: var(--neon-blue); font-family: 'JetBrains Mono', monospace;">
            <%= current_user.email.split('@').first %>
          </span>
        </div>
        <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "btn-danger", style: "margin-left: 8px;" %>
      <% else %>
        <!-- Unauthenticated User -->
        <%= link_to "Sign In", new_user_session_path, class: "btn-secondary" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "btn-success" %>
      <% end %>
    </div>
  </div>
</nav>

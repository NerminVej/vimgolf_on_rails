<div class="w-full">
  <h1 class="text-4xl font-bold text-gray-800 mb-4">Welcome to Vimgolf!</h1>
  <p class="text-lg text-gray-600 mb-8">
    Hello <%= current_user.email %>, you are successfully logged in.
  </p>

  <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-8">
    <h2 class="text-2xl font-semibold text-blue-900 mb-4">Getting Started</h2>
    <p class="text-gray-700 mb-4">
      This is your home page. You can customize it with your Vimgolf challenges and features.
    </p>
    <ul class="list-disc list-inside text-gray-700 space-y-2">
      <li>Complete Vim challenges</li>
      <li>Track your progress</li>
      <li>Compete with other players</li>
    </ul>
  </div>
</div>

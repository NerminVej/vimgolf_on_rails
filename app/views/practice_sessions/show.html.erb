<div class="w-full flex flex-col px-6 py-4 pt-12"
     data-controller="practice-editor"
     data-practice-editor-start-content-value="<%= @exercise.start_file.to_json %>"
     data-practice-editor-target-content-value="<%= @exercise.end_file.to_json %>"
     data-practice-editor-attempt-id-value="<%= @current_attempt.id %>"
     data-practice-editor-session-id-value="<%= @session.id %>"
     data-practice-editor-session-started-at-value="<%= @session.started_at.to_i %>"
     style="min-height: calc(100vh - 4rem); max-width: 1800px; margin: 0 auto;">

  <!-- Session Stats HUD -->
  <div class="hud-overlay mb-4 slide-in" style="background: linear-gradient(135deg, rgba(168, 85, 247, 0.15) 0%, rgba(236, 72, 153, 0.15) 100%); border-color: var(--neon-purple);">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-1">
        <div class="stat-box" style="background: rgba(168, 85, 247, 0.1);">
          <div class="stat-value" data-practice-editor-target="completedCount"><%= @session.total_exercises_completed %></div>
          <div class="stat-label">Completed</div>
        </div>
        <div class="stat-box" style="background: rgba(236, 72, 153, 0.1);">
          <div class="stat-value" data-practice-editor-target="attemptedCount"><%= @session.total_exercises_attempted %></div>
          <div class="stat-label">Attempted</div>
        </div>
        <div class="stat-box" style="background: rgba(0, 217, 255, 0.1);">
          <div class="stat-value" data-practice-editor-target="totalKeystrokes"><%= @session.total_keystrokes %></div>
          <div class="stat-label">Total Keys</div>
        </div>
        <div class="stat-box" style="background: rgba(251, 191, 36, 0.1);">
          <div class="stat-value" data-practice-editor-target="sessionTime" style="background: linear-gradient(135deg, var(--neon-yellow) 0%, var(--neon-green) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">00:00</div>
          <div class="stat-label">Time Elapsed</div>
        </div>
      </div>
      <%= button_to quit_practice_session_path(@session), method: :post, class: "btn-danger", data: { turbo_confirm: "Quit this practice session?" } do %>
        <span style="margin-right: 8px;">✕</span>Quit Session
      <% end %>
    </div>
  </div>

  <!-- Challenge Info -->
  <div class="hud-overlay mb-4 slide-in" style="animation-delay: 0.1s; padding: 16px;">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-6">
        <div>
          <span class="stat-label">Current Challenge</span>
          <h2 class="text-lg font-bold text-gradient"><%= @exercise.title %></h2>
        </div>
        <div class="border-l border-gray-700 pl-6">
          <span class="stat-label">Mission</span>
          <p style="color: var(--text-secondary); font-size: 14px;"><%= @exercise.description %></p>
        </div>
      </div>
      <div class="stat-box" style="min-width: 100px;">
        <div class="stat-value" data-practice-editor-target="keystrokes">0</div>
        <div class="stat-label">Keys Used</div>
      </div>
    </div>
  </div>

  <!-- Editors Grid -->
  <div class="flex-1 grid grid-cols-2 gap-6 overflow-hidden slide-in" style="animation-delay: 0.2s;">
    <!-- Vim Editor -->
    <div class="vim-terminal">
      <div class="vim-terminal-header">
        <span class="vim-terminal-dot red"></span>
        <span class="vim-terminal-dot yellow"></span>
        <span class="vim-terminal-dot green"></span>
        <span class="vim-terminal-title">~/practice/exercise.txt - VIM</span>
      </div>
      <div class="vim-editor-wrapper">
        <div data-practice-editor-target="editor" style="height: calc(100% - 28px);"></div>
        <div class="vim-status-bar" data-practice-editor-target="status">
          <div class="flex items-center gap-4">
            <span class="vim-mode-indicator">NORMAL</span>
            <span style="opacity: 0.7;">~/practice/exercise.txt</span>
          </div>
          <div class="flex items-center gap-4">
            <span>Ln 1, Col 1</span>
            <span data-practice-editor-target="keystrokes">0 keys</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Target Editor -->
    <div class="target-editor">
      <div class="target-editor-header">
        <div class="flex items-center justify-between">
          <span>🎯 TARGET OUTPUT</span>
          <span style="font-size: 12px; opacity: 0.7;">Transform your code to match this</span>
        </div>
      </div>
      <pre class="target-editor-content"><%= @exercise.end_file %></pre>
    </div>
  </div>
</div>

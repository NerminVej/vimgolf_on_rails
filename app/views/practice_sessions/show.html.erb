<div class="w-full h-screen flex flex-col"
     data-controller="practice-editor"
     data-practice-editor-start-content-value="<%= @exercise.start_file.to_json %>"
     data-practice-editor-target-content-value="<%= @exercise.end_file.to_json %>"
     data-practice-editor-attempt-id-value="<%= @current_attempt.id %>"
     data-practice-editor-session-id-value="<%= @session.id %>"
     data-practice-editor-session-started-at-value="<%= @session.started_at.to_i %>">

  <!-- Vim Editor at the TOP -->
  <div class="flex-1 grid grid-cols-2 gap-0 overflow-hidden">
    <div class="flex flex-col border-r border-gray-300">
      <div class="bg-gray-100 px-4 py-2 border-b border-gray-300">
        <h3 class="text-sm font-semibold text-gray-800">Your Editor</h3>
      </div>
      <div class="flex-1 p-3">
        <div data-practice-editor-target="editor" class="h-full" style="overflow: auto; font-family: 'Courier New', monospace;"></div>
      </div>
    </div>

    <div class="flex flex-col">
      <div class="bg-green-100 px-4 py-2 border-b border-green-300">
        <h3 class="text-sm font-semibold text-green-800">Target</h3>
      </div>
      <pre class="flex-1 p-3 overflow-auto text-sm font-mono bg-green-50"><%= @exercise.end_file %></pre>
    </div>
  </div>

  <!-- Session Stats, Description, and Status UNDER the editor -->
  <div class="bg-white border-t border-gray-300">
    <!-- Session Stats -->
    <div class="bg-purple-50 border-b border-purple-200 px-6 py-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-6">
          <div class="text-center">
            <div class="text-xs text-gray-600">Completed</div>
            <div class="text-lg font-bold text-purple-700" data-practice-editor-target="completedCount"><%= @session.total_exercises_completed %></div>
          </div>
          <div class="text-center">
            <div class="text-xs text-gray-600">Attempted</div>
            <div class="text-lg font-bold text-purple-700" data-practice-editor-target="attemptedCount"><%= @session.total_exercises_attempted %></div>
          </div>
          <div class="text-center">
            <div class="text-xs text-gray-600">Total Keystrokes</div>
            <div class="text-lg font-bold text-purple-700" data-practice-editor-target="totalKeystrokes"><%= @session.total_keystrokes %></div>
          </div>
          <div class="text-center">
            <div class="text-xs text-gray-600">Session Time</div>
            <div class="text-lg font-bold text-purple-700 font-mono" data-practice-editor-target="sessionTime">00:00</div>
          </div>
        </div>
        <%= button_to "✕ Quit", quit_practice_session_path(@session), method: :post, class: "px-3 py-1 text-sm bg-red-500 text-white rounded hover:bg-red-600 transition", data: { turbo_confirm: "Quit this practice session?" } %>
      </div>
    </div>

    <!-- Description and Status -->
    <div class="bg-gray-50 px-6 py-3" data-practice-editor-target="status">
      <div class="flex items-center justify-between text-sm">
        <div class="flex items-center gap-6">
          <div>
            <span class="font-semibold text-gray-700">Title:</span>
            <span class="text-gray-600"><%= @exercise.title %></span>
          </div>
          <div>
            <span class="font-semibold text-gray-700">Description:</span>
            <span class="text-gray-600"><%= @exercise.description %></span>
          </div>
          <div>
            <span class="font-semibold text-gray-700">Status:</span>
            <span class="text-gray-600">In Progress</span>
          </div>
        </div>
        <div>
          <span class="font-semibold text-gray-700">Current Keystrokes:</span>
          <span class="text-gray-600 font-mono ml-1" data-practice-editor-target="keystrokes">0</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .cm-editor {
    height: 100%;
    font-size: 16px;
    border: 1px solid #d1d5db;
  }
  .cm-scroller {
    overflow: auto;
    font-family: 'Courier New', Consolas, Monaco, monospace;
  }
  .cm-content {
    padding: 12px;
  }
  .cm-line {
    padding: 0 4px;
  }
</style>

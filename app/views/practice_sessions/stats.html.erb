<div class="w-full px-6 py-8" style="max-width: 1400px; margin: 0 auto; margin-top: 2rem;">
  <!-- Victory Header -->
  <div class="text-center mb-10 slide-in">
    <div style="font-size: 80px; margin-bottom: 20px; filter: drop-shadow(0 0 30px var(--neon-yellow));">🏆</div>
    <h1 class="text-6xl font-bold mb-4" style="font-family: 'JetBrains Mono', monospace; background: linear-gradient(135deg, var(--neon-yellow) 0%, var(--neon-pink) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
      MISSION COMPLETE
    </h1>
    <p style="color: var(--text-secondary); font-size: 18px;">
      <% if @session.quit_reason == 'completed_all' %>
        🎖️ Outstanding! You conquered all available challenges!
      <% elsif @session.quit_reason == 'manual_quit' %>
        💪 Solid session! You pushed your limits!
      <% else %>
        ✨ Practice session concluded
      <% end %>
    </p>
  </div>

  <!-- Session Summary -->
  <div class="hud-overlay mb-10 slide-in" style="animation-delay: 0.1s; background: linear-gradient(135deg, rgba(168, 85, 247, 0.15) 0%, rgba(236, 72, 153, 0.15) 100%); border-color: var(--neon-purple); padding: 32px;">
    <h2 class="text-3xl font-bold mb-8 text-center text-gradient" style="font-family: 'JetBrains Mono', monospace;">PERFORMANCE STATS</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
      <div class="stat-box pulse-glow" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(5, 150, 105, 0.15) 100%);">
        <div style="font-size: 32px; margin-bottom: 8px;">✅</div>
        <div class="stat-value" style="background: linear-gradient(135deg, var(--neon-green) 0%, var(--neon-blue) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"><%= @session.total_exercises_completed %></div>
        <div class="stat-label">Completed</div>
      </div>
      <div class="stat-box" style="background: linear-gradient(135deg, rgba(0, 217, 255, 0.15) 0%, rgba(168, 85, 247, 0.15) 100%);">
        <div style="font-size: 32px; margin-bottom: 8px;">🎯</div>
        <div class="stat-value"><%= @session.total_exercises_attempted %></div>
        <div class="stat-label">Attempts</div>
      </div>
      <div class="stat-box" style="background: linear-gradient(135deg, rgba(168, 85, 247, 0.15) 0%, rgba(236, 72, 153, 0.15) 100%);">
        <div style="font-size: 32px; margin-bottom: 8px;">⌨️</div>
        <div class="stat-value" style="background: linear-gradient(135deg, var(--neon-purple) 0%, var(--neon-pink) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"><%= @session.total_keystrokes %></div>
        <div class="stat-label">Total Keys</div>
      </div>
      <div class="stat-box" style="background: linear-gradient(135deg, rgba(251, 191, 36, 0.15) 0%, rgba(239, 68, 68, 0.15) 100%);">
        <div style="font-size: 32px; margin-bottom: 8px;">⏱️</div>
        <div class="stat-value" style="background: linear-gradient(135deg, var(--neon-yellow) 0%, var(--neon-red) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
          <%= Time.at(@session.total_duration_seconds || 0).utc.strftime("%M:%S") %>
        </div>
        <div class="stat-label">Duration</div>
      </div>
      <div class="stat-box" style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(168, 85, 247, 0.15) 100%);">
        <div style="font-size: 32px; margin-bottom: 8px;">📊</div>
        <div class="stat-value"><%= @average_keystrokes %></div>
        <div class="stat-label">Avg Keys</div>
      </div>
      <div class="stat-box pulse-glow" style="background: linear-gradient(135deg, rgba(20, 184, 166, 0.15) 0%, rgba(16, 185, 129, 0.15) 100%); animation-delay: 0.5s;">
        <div style="font-size: 32px; margin-bottom: 8px;">🎖️</div>
        <div class="stat-value" style="background: linear-gradient(135deg, var(--neon-green) 0%, var(--neon-blue) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"><%= @success_rate %>%</div>
        <div class="stat-label">Success Rate</div>
      </div>
    </div>
  </div>

  <!-- Exercise Breakdown -->
  <div class="game-card mb-10 slide-in" style="animation-delay: 0.2s; padding: 32px;">
    <h2 class="text-3xl font-bold mb-8 text-gradient" style="font-family: 'JetBrains Mono', monospace;">CHALLENGE LOG</h2>

    <% if @attempts.any? %>
      <div class="space-y-4">
        <% @attempts.each_with_index do |attempt, index| %>
          <div class="<%= attempt.success ? 'game-card' : 'hud-overlay' %> slide-in" style="padding: 20px; animation-delay: <%= 0.25 + (index * 0.05) %>s; <%= attempt.success ? 'border-color: var(--neon-green); background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(5, 150, 105, 0.1) 100%);' : '' %>">
            <div class="flex items-center justify-between">
              <div class="flex-1 flex items-center gap-4">
                <div style="width: 48px; height: 48px; border-radius: 8px; background: linear-gradient(135deg, var(--neon-blue) 0%, var(--neon-purple) 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 20px; font-family: 'JetBrains Mono', monospace;">
                  #<%= index + 1 %>
                </div>
                <div class="flex-1">
                  <% if attempt.exercise %>
                    <h3 class="text-lg font-bold mb-1">
                      <%= link_to attempt.exercise.title, exercise_path(attempt.exercise), style: "text-decoration: none; color: var(--neon-blue);" %>
                    </h3>
                  <% else %>
                    <h3 class="text-lg font-bold mb-1" style="color: var(--text-muted); font-style: italic;">Exercise deleted</h3>
                  <% end %>

                  <% if attempt.success %>
                    <div style="display: inline-block; padding: 4px 12px; background: linear-gradient(135deg, var(--neon-green) 0%, var(--neon-blue) 100%); border-radius: 20px; color: white; font-size: 12px; font-weight: 700;">
                      ✓ COMPLETED
                    </div>
                  <% elsif attempt.skipped %>
                    <div style="display: inline-block; padding: 4px 12px; background: rgba(255, 255, 255, 0.1); border-radius: 20px; color: var(--text-muted); font-size: 12px; font-weight: 700;">
                      SKIPPED
                    </div>
                  <% else %>
                    <div style="display: inline-block; padding: 4px 12px; background: linear-gradient(135deg, var(--neon-yellow) 0%, var(--neon-red) 100%); border-radius: 20px; color: white; font-size: 12px; font-weight: 700;">
                      IN PROGRESS
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="flex items-center gap-6">
                <% if attempt.duration_seconds %>
                  <div class="text-center">
                    <div style="color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">Time</div>
                    <div style="color: var(--text-primary); font-size: 18px; font-weight: 700; font-family: 'JetBrains Mono', monospace;">
                      <%= Time.at(attempt.duration_seconds).utc.strftime("%M:%S") %>
                    </div>
                  </div>
                <% end %>

                <% if attempt.success %>
                  <div class="text-center">
                    <div style="color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">Keys</div>
                    <div class="stat-value" style="font-size: 24px;"><%= attempt.keystrokes %></div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p style="color: var(--text-muted); text-align: center; padding: 40px 0; font-size: 16px;">No attempts recorded</p>
    <% end %>
  </div>

  <!-- Action Buttons -->
  <div class="flex justify-center gap-4 slide-in" style="animation-delay: 0.3s;">
    <%= button_to practice_sessions_path, method: :post, class: "btn-primary", style: "font-size: 18px; padding: 18px 36px; font-weight: 700;" do %>
      <span style="margin-right: 10px;">⚡</span>New Practice Session
    <% end %>
    <%= link_to exercises_path, class: "btn-secondary", style: "font-size: 18px; padding: 18px 36px; font-weight: 700;" do %>
      <span style="margin-right: 10px;">←</span>Browse Challenges
    <% end %>
  </div>
</div>

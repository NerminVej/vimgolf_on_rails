<div class="max-w-6xl mx-auto">
  <div class="text-center mb-8">
    <h1 class="text-5xl font-bold text-purple-700 mb-3">🎉 Practice Session Complete!</h1>
    <p class="text-gray-600 text-lg">
      <% if @session.quit_reason == 'completed_all' %>
        Congratulations! You completed all available exercises!
      <% elsif @session.quit_reason == 'manual_quit' %>
        You ended the practice session. Great work!
      <% else %>
        Practice session ended.
      <% end %>
    </p>
  </div>

  <!-- Session Summary -->
  <div class="bg-gradient-to-r from-purple-50 to-blue-50 border border-purple-200 rounded-xl p-8 mb-8 shadow-lg">
    <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Session Summary</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
      <div class="bg-white rounded-lg p-4 text-center shadow">
        <div class="text-sm text-gray-600 mb-2">Exercises Completed</div>
        <div class="text-4xl font-bold text-green-600"><%= @session.total_exercises_completed %></div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow">
        <div class="text-sm text-gray-600 mb-2">Total Attempts</div>
        <div class="text-4xl font-bold text-blue-600"><%= @session.total_exercises_attempted %></div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow">
        <div class="text-sm text-gray-600 mb-2">Total Keystrokes</div>
        <div class="text-4xl font-bold text-purple-600"><%= @session.total_keystrokes %></div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow">
        <div class="text-sm text-gray-600 mb-2">Session Duration</div>
        <div class="text-4xl font-bold text-orange-600 font-mono">
          <%= Time.at(@session.total_duration_seconds || 0).utc.strftime("%M:%S") %>
        </div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow">
        <div class="text-sm text-gray-600 mb-2">Avg Keystrokes</div>
        <div class="text-4xl font-bold text-indigo-600"><%= @average_keystrokes %></div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow">
        <div class="text-sm text-gray-600 mb-2">Success Rate</div>
        <div class="text-4xl font-bold text-teal-600"><%= @success_rate %>%</div>
      </div>
    </div>
  </div>

  <!-- Exercise Breakdown -->
  <div class="bg-white border border-gray-300 rounded-xl p-8 mb-8 shadow-lg">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Exercise Breakdown</h2>

    <% if @attempts.any? %>
      <div class="space-y-4">
        <% @attempts.each_with_index do |attempt, index| %>
          <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition <%= attempt.success ? 'bg-green-50 border-green-300' : 'bg-gray-50' %>">
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <div class="flex items-center gap-3">
                  <span class="text-2xl font-bold text-gray-400">#<%= index + 1 %></span>
                  <% if attempt.exercise %>
                    <h3 class="text-lg font-semibold text-gray-800">
                      <%= link_to attempt.exercise.title, exercise_path(attempt.exercise), class: "hover:text-blue-600 transition" %>
                    </h3>
                  <% else %>
                    <h3 class="text-lg font-semibold text-gray-500 italic">Exercise deleted</h3>
                  <% end %>

                  <% if attempt.success %>
                    <span class="px-3 py-1 bg-green-500 text-white text-sm font-semibold rounded-full">✓ Completed</span>
                  <% elsif attempt.skipped %>
                    <span class="px-3 py-1 bg-gray-400 text-white text-sm font-semibold rounded-full">Skipped</span>
                  <% else %>
                    <span class="px-3 py-1 bg-yellow-400 text-gray-800 text-sm font-semibold rounded-full">In Progress</span>
                  <% end %>
                </div>
              </div>

              <div class="flex items-center gap-6">
                <% if attempt.duration_seconds %>
                  <div class="text-center">
                    <div class="text-xs text-gray-500">Duration</div>
                    <div class="text-lg font-semibold text-gray-700 font-mono">
                      <%= Time.at(attempt.duration_seconds).utc.strftime("%M:%S") %>
                    </div>
                  </div>
                <% end %>

                <% if attempt.success %>
                  <div class="text-center">
                    <div class="text-xs text-gray-500">Keystrokes</div>
                    <div class="text-lg font-bold text-purple-600 font-mono"><%= attempt.keystrokes %></div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8">No attempts recorded.</p>
    <% end %>
  </div>

  <!-- Action Buttons -->
  <div class="flex justify-center gap-4">
    <%= button_to "🎯 Start New Practice Session", practice_sessions_path, method: :post, class: "px-8 py-4 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition font-bold text-lg shadow-lg" %>
    <%= link_to "← Back to Exercises", exercises_path, class: "px-8 py-4 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition font-bold text-lg shadow-lg" %>
  </div>
</div>

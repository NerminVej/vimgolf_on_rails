<div class="min-h-screen bg-gradient-to-b from-gray-900 to-black text-white p-6">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold mb-2">
        <% if @session.completed_stages > 0 %>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-400">
            Training Complete! 🎯
          </span>
        <% else %>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-gray-400 to-gray-500">
            Session Ended
          </span>
        <% end %>
      </h1>
      <p class="text-gray-400">Star Hunt Training Session Results</p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 gap-4 mb-8">
      <!-- Stages Cleared -->
      <div class="bg-gradient-to-br from-cyan-600/20 to-cyan-800/20 backdrop-blur-sm rounded-lg p-6 border border-cyan-500/30">
        <div class="text-cyan-400 text-sm uppercase tracking-wide mb-2">Stages Cleared</div>
        <div class="text-4xl font-bold text-white"><%= @session.completed_stages %></div>
      </div>

      <!-- Total Keystrokes -->
      <div class="bg-gradient-to-br from-purple-600/20 to-purple-800/20 backdrop-blur-sm rounded-lg p-6 border border-purple-500/30">
        <div class="text-purple-400 text-sm uppercase tracking-wide mb-2">Total Keystrokes</div>
        <div class="text-4xl font-bold text-white"><%= @session.total_keystrokes %></div>
      </div>

      <!-- Average Keystrokes per Stage -->
      <div class="bg-gradient-to-br from-pink-600/20 to-pink-800/20 backdrop-blur-sm rounded-lg p-6 border border-pink-500/30">
        <div class="text-pink-400 text-sm uppercase tracking-wide mb-2">Avg Keys per Stage</div>
        <div class="text-4xl font-bold text-white">
          <%= @session.completed_stages > 0 ? (@session.total_keystrokes.to_f / @session.completed_stages).round(1) : 0 %>
        </div>
      </div>

      <!-- Session Duration -->
      <div class="bg-gradient-to-br from-yellow-600/20 to-yellow-800/20 backdrop-blur-sm rounded-lg p-6 border border-yellow-500/30">
        <div class="text-yellow-400 text-sm uppercase tracking-wide mb-2">Session Duration</div>
        <div class="text-4xl font-bold text-white">
          <% if @session.ended_at && @session.created_at %>
            <% duration = (@session.ended_at - @session.created_at).to_i %>
            <%= duration / 60 %>m <%= duration % 60 %>s
          <% else %>
            0m 0s
          <% end %>
        </div>
      </div>
    </div>

    <!-- Performance Tips -->
    <% if @session.completed_stages > 0 %>
      <div class="bg-gray-800/50 backdrop-blur-sm rounded-lg p-6 border border-cyan-500/30 mb-6">
        <h3 class="text-lg font-semibold text-cyan-400 mb-3">💡 Tips for Better Performance</h3>
        <ul class="space-y-2 text-gray-300 text-sm">
          <li>• Use <code class="bg-gray-700 px-2 py-1 rounded text-cyan-400">f*</code> to jump directly to the star on the current line</li>
          <li>• Use <code class="bg-gray-700 px-2 py-1 rounded text-cyan-400">/{pattern}</code> to search for the star across all lines</li>
          <li>• Press <code class="bg-gray-700 px-2 py-1 rounded text-cyan-400">x</code> or <code class="bg-gray-700 px-2 py-1 rounded text-cyan-400">dl</code> to delete the character under the cursor</li>
          <li>• Combine movements: <code class="bg-gray-700 px-2 py-1 rounded text-cyan-400">gg</code> (top), <code class="bg-gray-700 px-2 py-1 rounded text-cyan-400">G</code> (bottom), <code class="bg-gray-700 px-2 py-1 rounded text-cyan-400">{line}G</code> (specific line)</li>
          <li>• Optimal solution is usually 3-5 keystrokes: search, navigate, delete</li>
        </ul>
      </div>
    <% end %>

    <!-- Action Buttons -->
    <div class="flex gap-4 justify-center">
      <%= button_to "Start New Training", star_hunt_sessions_path,
          class: "px-6 py-3 bg-gradient-to-r from-cyan-600 to-purple-600 hover:from-cyan-700 hover:to-purple-700 text-white rounded-lg font-semibold transition shadow-lg" %>

      <%= link_to "Back to Home", root_path,
          class: "px-6 py-3 bg-gray-700 hover:bg-gray-600 text-white rounded-lg font-semibold transition" %>

      <%= button_to "Delete Session", star_hunt_session_path(@session), method: :delete,
          data: { turbo_confirm: "Delete this training session? This cannot be undone." },
          class: "px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-lg font-semibold transition" %>
    </div>
  </div>
</div>

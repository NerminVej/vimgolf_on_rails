<div class="w-full max-w-md mx-auto px-6 py-12">
  <div class="game-card slide-in" style="padding: 40px;">
    <!-- Header -->
    <div class="text-center mb-8">
      <div style="font-size: 56px; margin-bottom: 16px; filter: drop-shadow(0 0 20px var(--neon-green));">⚡</div>
      <h2 class="text-4xl font-bold mb-2 text-gradient" style="font-family: 'JetBrains Mono', monospace;">
        Join VimGolf
      </h2>
      <p style="color: var(--text-muted); font-size: 14px;">Create your account and start competing</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
      </div>

      <div>
        <div class="flex items-center justify-between mb-2">
          <%= f.label :password, class: "form-label", style: "margin: 0;" %>
          <% if @minimum_password_length %>
            <span style="color: var(--text-muted); font-size: 12px;">(<%= @minimum_password_length %> chars min)</span>
          <% end %>
        </div>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-input" %>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
      </div>

      <div>
        <%= f.submit "Create Account", class: "btn-success", style: "width: 100%; cursor: pointer; font-size: 16px; padding: 14px;" %>
      </div>
    <% end %>

    <div class="mt-8 pt-6" style="border-top: 1px solid rgba(255, 255, 255, 0.1);">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>

<style>
  .devise-links a {
    color: var(--neon-blue);
    text-decoration: none;
    font-size: 14px;
    transition: all 0.3s ease;
  }
  .devise-links a:hover {
    color: var(--neon-purple);
    text-shadow: 0 0 10px rgba(0, 217, 255, 0.5);
  }
</style>

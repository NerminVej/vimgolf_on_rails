<div class="w-full min-h-screen flex items-center justify-center">
<div class="w-full max-w-md mx-auto px-6 py-12">
  <div class="game-card slide-in" style="padding: 40px;">
    <!-- Header -->
    <div class="text-center mb-8">
      <div style="font-size: 56px; margin-bottom: 16px; filter: drop-shadow(0 0 20px var(--neon-blue));">🎮</div>
      <h2 class="text-4xl font-bold mb-2 text-gradient" style="font-family: 'JetBrains Mono', monospace;">
        Sign In
      </h2>
      <p style="color: var(--text-muted); font-size: 14px;">Welcome back, Player</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
      <div>
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
      </div>

      <div>
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me, class: "w-4 h-4 rounded", style: "accent-color: var(--neon-blue);" %>
          <%= f.label :remember_me, style: "color: var(--text-secondary); font-size: 14px; cursor: pointer;" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "Sign In", class: "btn-primary", style: "width: 100%; cursor: pointer; font-size: 16px; padding: 14px;" %>
      </div>
    <% end %>

    <div class="mt-8 pt-6" style="border-top: 1px solid rgba(255, 255, 255, 0.1);">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
</div>

<style>
  .devise-links a {
    color: var(--neon-blue);
    text-decoration: none;
    font-size: 14px;
    transition: all 0.3s ease;
  }
  .devise-links a:hover {
    color: var(--neon-purple);
    text-shadow: 0 0 10px rgba(0, 217, 255, 0.5);
  }
</style>
